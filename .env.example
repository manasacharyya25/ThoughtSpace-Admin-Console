# Supabase (same project as ThoughtSpace main app)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login password
ADMIN_PASSWORD=change-me

# Pexels API (https://www.pexels.com/api/) — server-side only
PEXELS_API_KEY=your-pexels-api-key

# Optional: public site URL for preview links
NEXT_PUBLIC_SITE_URL=https://thoughtspace.online

# Run docs/migrations/*.sql in Supabase before using rich text / photo credits
